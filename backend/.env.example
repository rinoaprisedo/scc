APP_ENV=development
APP_PORT=8880
FRONTEND_URL=http://localhost:8881,http://localhost:8502,http://localhost:8882
# Leave empty for local dev (host-only cookie works fine on localhost,
# port differences don't matter for cookies). In production, set to the
# shared parent domain (e.g. ".example.com") when the frontend(s) and API
# live on different subdomains — otherwise the frontend JS can't read the
# CSRF cookie via document.cookie and every state-changing request 403s
# with "invalid or missing CSRF token".
COOKIE_DOMAIN=

DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5435
DB_USER=postgres
DB_PASS=password
DB_NAME=scc

REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_PASS=
REDIS_DB=0

SESSION_MAX_AGE=86400
SESSION_MAX_CONCURRENT=3

STORAGE_MAX_SIZE=3145728

S3_ENDPOINT=https://your-s3-compatible-endpoint
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

LOG_CLEANUP_DAYS=90
RATE_LIMIT_LOGIN=5
RATE_LIMIT_LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_API=100

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
